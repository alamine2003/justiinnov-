# Modèle du fichier `.env` posé sur le serveur, à côté de
# docker-compose.prod.yml. Il n'est jamais versionné.
#
#   cp .env.example .env && chmod 600 .env
#
# Les variables d'image (BACKEND_IMAGE, FRONTEND_IMAGE, IMAGE_TAG) sont
# fournies par la livraison continue à chaque déploiement ; ne les mettez ici
# que pour un lancement manuel.

# --- Domaine et TLS ---------------------------------------------------------
APP_DOMAIN=controle-budgetaire.example.org
# Adresse prévenue par Let's Encrypt avant l'expiration d'un certificat.
ACME_EMAIL=

# --- Django -----------------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=controle-budgetaire.example.org
CORS_ALLOWED_ORIGINS=https://controle-budgetaire.example.org
APP_BASE_URL=https://controle-budgetaire.example.org
DJANGO_TIME_ZONE=UTC
# Redirection HTTPS par Django (1 par défaut hors mode debug). Caddy termine
# TLS et transmet X-Forwarded-Proto ; Django ne redirige donc que ce qui
# arrive réellement en clair. `/api/health/` en est exempté, pour que le
# contrôle de santé interne (HTTP, sans proxy) reste possible.
DJANGO_SECURE_SSL_REDIRECT=1
# Nombre de proxys de confiance devant Django : Caddy puis nginx. Sert à
# lire la vraie adresse du client dans X-Forwarded-For (journal d'audit,
# limitation de débit) sans qu'un client puisse la forger en ajoutant un
# en-tête. Mettre 1 si Caddy est retiré ou 3 derrière un équilibreur.
DJANGO_NUM_PROXIES=2
# Durée de vie d'un jeton d'API, en jours. Un jeton plus ancien est refusé et
# l'utilisateur se reconnecte.
TOKEN_MAX_AGE_DAYS=30

# --- Serveur d'application (gunicorn) --------------------------------------
# Processus (2 par défaut) × fils d'exécution (4 par défaut) = requêtes
# servies en parallèle. Sur une machine à 2 cœurs, laissez tel quel ; à 4
# cœurs, GUNICORN_WORKERS=3. Chaque processus coûte ~120 Mo.
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
# Délai, en secondes, au-delà duquel une requête est abandonnée : un export
# Excel d'une année complète ou le dépôt d'une pièce de 20 Mo sur une liaison
# lente peuvent dépasser les 30 s par défaut de gunicorn.
GUNICORN_TIMEOUT=120

# --- Base de données --------------------------------------------------------
POSTGRES_DB=justi_innov
POSTGRES_USER=justi
POSTGRES_PASSWORD=
# Rôle applicatif à moindre privilège, une fois creer_role_applicatif.sql
# joué (README.md, « Rôle Postgres applicatif ») : le service tourne avec
# POSTGRES_USER, sans droit de modifier le schéma ; les migrations, la table
# de cache, le conteneur Postgres et les sauvegardes gardent le propriétaire.
# Laissez ces deux lignes commentées tant que le script n'a pas été joué.
#POSTGRES_MIGRATION_USER=justi
#POSTGRES_MIGRATION_PASSWORD=
# Base hébergée hors de la pile : DATABASE_URL prime alors sur les
# POSTGRES_* ci-dessus. Les paramètres de la chaîne de requête sont ceux de
# libpq, transmis tels quels (sslmode, channel_binding, options…) ; un mot de
# passe contenant `@`, `/` ou `%` s'encode (`%40`, `%2F`, `%25`).
# DATABASE_MIGRATION_URL joue le rôle de POSTGRES_MIGRATION_USER.
#DATABASE_URL=postgresql://justi_app:mot%40de%2Fpasse@hote.example.org:5432/justi_innov?sslmode=require&channel_binding=require
#DATABASE_MIGRATION_URL=postgresql://justi:...@hote.example.org:5432/justi_innov?sslmode=require

# --- Sauvegardes (sauvegarder.sh, volume `sauvegardes`) ---------------------
# Heure UTC du pg_dump quotidien, et rétention des dumps en jours. Le miroir
# des justificatifs suit un quart d'heure plus tard.
SAUVEGARDE_HEURE=02:00
SAUVEGARDE_PIECES_HEURE=02:15
SAUVEGARDE_RETENTION_JOURS=14

# --- Stockage des justificatifs (MinIO) -------------------------------------
AWS_ACCESS_KEY_ID=justi
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=justificatifs

# --- Courrier ---------------------------------------------------------------
# Sans EMAIL_HOST, les messages vont dans les journaux du backend.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=controle-budgetaire@example.org

# --- Cadences de l'ordonnanceur (syntaxe cron) ------------------------------
SCHEDULE_ALERTS=0 * * * *
SCHEDULE_WEEKLY_REPORT=0 7 * * 1
SCHEDULE_MONTHLY_REPORT=0 7 1 * *
