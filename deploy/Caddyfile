# Entrée publique : TLS automatique (Let's Encrypt), puis tout part au
# conteneur nginx du frontend, qui sert l'interface et relaie `/api/` vers
# Django. Caddy pose `X-Forwarded-Proto: https`, que nginx transmet et que
# Django lit (`SECURE_PROXY_SSL_HEADER`) pour ne pas rediriger en boucle.
{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	encode zstd gzip

	# HSTS se pose ici, au seul endroit qui termine TLS : nginx ne voit que
	# du HTTP et Django ne couvre que `/api/`. Un an, sous-domaines compris ;
	# le préchargement reste du ressort de Django (DJANGO_HSTS_PRELOAD).
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# Les justificatifs peuvent peser jusqu'à 20 Mo (MAX_PROOF_SIZE) ; un peu
	# de marge pour l'enveloppe multipart.
	request_body {
		max_size 25MB
	}

	reverse_proxy frontend:80

	log {
		output stdout
		format console
	}
}
