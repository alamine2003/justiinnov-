            "uid": "bi"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT bi.ratio(sum(m) FILTER (WHERE rang <= 10), sum(m)) FROM ( SELECT sum(montant_xof) AS m, row_number() OVER (ORDER BY sum(montant_xof) DESC NULLS LAST) AS rang FROM bi.lignes WHERE annee = $annee AND pays_id IN (${pays:csv}) AND ('__tous' IN (${type_projet:sqlstring}) OR type_projet_code IN (${type_projet:sqlstring})) AND (engagee OR consommee) AND beneficiaire_id IS NOT NULL GROUP BY beneficiaire_id) AS b"
        }
      ],
