    {
      "type": "stat",
      "title": "Part des 10 premiers bénéficiaires",
      "description": "Concentration : part du montant qui va aux dix premiers bénéficiaires.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bi"
      },
      "targets": [
        {
          "refId": "A",
