  "panels": [
    {
      "type": "table",
      "title": "Enveloppes",
      "description": "Montants dans la devise du pays. Les réallocations approuvées sont déjà dans le montant.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bi"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bi"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT pays AS \"Pays\", CASE portee WHEN 'pays' THEN 'Pays' WHEN 'projet' THEN 'Projet' WHEN 'equipe' THEN 'Équipe' ELSE 'Manager' END AS \"Portée\", cible AS \"Enveloppe\", devise AS \"Devise\", montant AS \"Montant\", engage AS \"Engagé\", consomme AS \"Consommé\", justifie AS \"Justifié\", disponible AS \"Disponible\", taux_execution AS \"Exécution\", libelle_niveau AS \"Niveau\", CASE alerte WHEN 'budget_overrun' THEN 'Dépassement de ' || depassement::text WHEN 'budget_threshold' THEN 'Seuil ' || seuil_atteint::integer || ' %' ELSE '' END AS \"Alerte\", CASE politique_depassement WHEN 'block' THEN 'Bloquer' WHEN 'warn' THEN 'Alerter' ELSE 'Approbation' END AS \"Politique\" FROM bi.enveloppes WHERE annee = $annee AND pays_id IN (${pays:csv}) ORDER BY pays, portee DESC, cible"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
