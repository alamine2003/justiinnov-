        "w": 12,
        "h": 10
      }
    },
    {
      "type": "table",
      "title": "Réallocations",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bi"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bi"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT r.demandee_le AS \"Demandée le\", r.pays AS \"Pays\", es.cible AS \"De\", ec.cible AS \"Vers\", r.montant AS \"Montant\", r.devise AS \"Devise\", r.libelle_etat AS \"État\", r.demandee_par AS \"Demandée par\", r.decidee_par AS \"Décidée par\" FROM bi.reallocations AS r LEFT JOIN bi.enveloppes AS es ON es.id = r.enveloppe_source_id LEFT JOIN bi.enveloppes AS ec ON ec.id = r.enveloppe_cible_id WHERE r.annee = $annee AND r.pays_id IN (${pays:csv}) ORDER BY r.demandee_le DESC"
        }
      ],
      "fieldConfig": {
