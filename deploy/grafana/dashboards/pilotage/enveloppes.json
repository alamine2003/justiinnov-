    {
      "type": "stat",
      "title": "Devises sans taux",
      "description": "Devises sans taux publié à la date de référence : leurs pays manquent à la projection et à la comparaison en FCFA, ci-dessous.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bi"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bi"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT coalesce(string_agg(DISTINCT devise, ', ') FILTER (WHERE taux_xof IS NULL), 'Aucune') FROM bi.consolidation_pays WHERE annee = $annee AND pays_id IN (${pays:csv})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "orientation": "auto"
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 3
      }
    },
    {
      "transformations": [],
      "type": "barchart",
      "title": "Projection de fin d'exercice (FCFA)",
      "description": "Engagé et consommé ramenés à l'année entière au rythme observé depuis le 1er janvier. Une projection au-dessus de l'attribué annonce un dépassement si le rythme se maintient.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bi"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bi"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT pays AS \"Pays\", attribue_xof AS \"Attribué\", bi.arrondi((consomme_xof + engage_xof) / greatest(least(bi.aujourd_hui(), make_date($annee, 12, 31)) - make_date($annee, 1, 1) + 1, 1) * (make_date($annee, 12, 31) - make_date($annee, 1, 1) + 1), 0) AS \"Projection\" FROM bi.consolidation_pays WHERE annee = $annee AND pays_id IN (${pays:csv}) AND taux_xof IS NOT NULL ORDER BY pays"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "locale",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "stacking": "none",
        "showValue": "never",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "xTickLabelRotation": 0,
        "barWidth": 0.8,
        "groupWidth": 0.7
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 15
      }
    },
    {
      "transformations": [],
      "type": "barchart",
      "title": "Comparaison avec l'exercice précédent (FCFA)",
      "description": "Engagé et consommé, aux taux de chaque exercice.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bi"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bi"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT p.nom AS \"Pays\", coalesce(sum(c.consomme_xof + c.engage_xof) FILTER (WHERE c.annee = $annee - 1), 0) AS \"Exercice précédent\", coalesce(sum(c.consomme_xof + c.engage_xof) FILTER (WHERE c.annee = $annee), 0) AS \"Exercice choisi\" FROM bi.pays AS p JOIN bi.consolidation_pays AS c ON c.pays_id = p.id WHERE c.annee IN ($annee, $annee - 1) AND p.id IN (${pays:csv}) GROUP BY p.nom ORDER BY p.nom"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "locale",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "stacking": "none",
        "showValue": "never",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        },
        "xTickLabelRotation": 0,
        "barWidth": 0.8,
        "groupWidth": 0.7
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 15
      }
    },
    {
      "type": "bargauge",
      "title": "Exécution des enveloppes de projet",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bi"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bi"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT cible || ' (' || pays || ')' AS \"Projet\", taux_execution AS \"Exécution\" FROM bi.enveloppes WHERE annee = $annee AND pays_id IN (${pays:csv}) AND portee = 'projet' AND taux_execution IS NOT NULL ORDER BY taux_execution DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "percentunit",
          "decimals": 1,
          "thresholds": {
