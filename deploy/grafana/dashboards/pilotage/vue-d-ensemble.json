          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT * FROM ( SELECT CASE alerte WHEN 'budget_overrun' THEN 'Dépassement' ELSE 'Seuil ' || seuil_atteint::integer || ' %' END AS \"Alerte\", CASE gravite WHEN 'critical' THEN 'Critique' ELSE 'Avertissement' END AS \"Gravité\", pays AS \"Pays\", cible AS \"Objet\", coalesce(pourcentage_utilise::text || ' % utilisés', '') AS \"Détail\" FROM bi.enveloppes WHERE annee = $annee AND alerte IS NOT NULL UNION ALL SELECT CASE alerte WHEN 'proof_missing' THEN 'Justificatif manquant' ELSE 'Justificatif incomplet' END, CASE alerte WHEN 'proof_missing' THEN 'Critique' ELSE 'Avertissement' END, pays, numero || ' — ' || libelle, lignes_sans_preuve || ' ligne(s) sans preuve' FROM bi.dossiers WHERE alerte IS NOT NULL UNION ALL SELECT 'Dépense inhabituelle', 'Avertissement', pays, numero_dossier || ' — ' || libelle, montant::text || ' ' || devise FROM bi.inhabituelles WHERE annee = $annee ) AS alertes ORDER BY \"Gravité\" DESC, \"Pays\""
