    {
      "transformations": [],
      "type": "barchart",
      "title": "Ancienneté de la file",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "bi"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "bi"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT tr.libelle AS \"Ancienneté\", count(f.ligne_id) AS \"Lignes\" FROM (VALUES (1, '0 à 7 jours', 0, 7), (2, '8 à 30 jours', 7, 30), (3, '31 à 90 jours', 30, 90), (4, 'Plus de 90 jours', 90, NULL), (5, 'Soumission non tracée', NULL, NULL)) AS tr(rang, libelle, apres, jusqu_a) LEFT JOIN (SELECT ligne_id, jours_en_attente FROM bi.file_controle WHERE pays_id IN (${pays:csv})) AS f ON CASE WHEN tr.rang = 5 THEN f.jours_en_attente IS NULL ELSE f.jours_en_attente > tr.apres - CASE WHEN tr.rang = 1 THEN 1 ELSE 0 END AND (tr.jusqu_a IS NULL OR f.jours_en_attente <= tr.jusqu_a) END GROUP BY tr.rang, tr.libelle ORDER BY tr.rang"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "vertical",
        "stacking": "none",
        "showValue": "never",
        "legend": {
          "displayMode": "list",
