msgid "Une sous-enveloppe ne découpe qu'une dimension à la fois (reçu : {received})."
msgstr "A sub-envelope splits along only one dimension at a time (received: {received})."

msgid "Cette entité doit appartenir au pays de l'enveloppe."
msgstr "This entity must belong to the envelope's country."

msgid "Ce manager n'est pas rattaché au pays de l'enveloppe."
msgstr "This manager is not attached to the envelope's country."

msgid "Des dépenses sont imputées à cette enveloppe : son pays, son année et son découpage ne se modifient plus."
msgstr "Expenses are charged to this envelope: its country, year and split can no longer be changed."

msgid "ce projet"
msgstr "this project"

