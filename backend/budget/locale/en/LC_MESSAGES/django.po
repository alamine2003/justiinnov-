msgstr "this manager"

msgid "Une enveloppe existe déjà pour ce pays et cette année."
msgstr "An envelope already exists for this country and year."

msgid "Une sous-enveloppe existe déjà pour {scope} et cette année."
msgstr "A sub-envelope already exists for {scope} and this year."

msgid "La justification est obligatoire."
msgstr "A justification is required."

msgid "La source et la destination doivent différer."
msgstr "Source and target must differ."

msgid "Les deux enveloppes doivent être dans la même devise ({source} → {target})."
msgstr "Both envelopes must be in the same currency ({source} → {target})."

msgid "Le montant dépasse le disponible de l'enveloppe source ({available})."
msgstr "The amount exceeds what is available in the source envelope ({available})."

msgid "Le taux doit être strictement positif."
msgstr "The rate must be strictly positive."

msgid "Un taux ne se publie pas pour une date future."
msgstr "A rate cannot be published for a future date."

msgid "Le disponible de l'enveloppe source ne couvre plus ce montant."
msgstr "The source envelope's available balance no longer covers this amount."

msgid "Un refus doit être motivé."
msgstr "A refusal must state a reason."

msgid "Cette réallocation a déjà été traitée."
msgstr "This reallocation has already been processed."

msgid "Vous ne pouvez pas décider d'une réallocation que vous avez demandée."
msgstr "You cannot decide on a reallocation you requested yourself."
