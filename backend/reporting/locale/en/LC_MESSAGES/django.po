# Traductions anglaises de l'application « reporting ».
# Les en-têtes de colonnes des exports (contrat de fichier) ne sont pas
# traduits : ils restent en français dans tous les formats.
msgid ""
msgstr ""
"Project-Id-Version: controle-budgetaire\n"
"Report-Msgid-Bugs-To: \n"
"POT-Creation-Date: 2026-09-04 13:24+0000\n"
"PO-Revision-Date: 2026-09-04 00:00+0000\n"
"Last-Translator: \n"
"Language-Team: \n"
"Language: en\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid " ({taux} % engagés)"
msgstr " ({taux} % committed)"

msgid "Dépassement — {budget}"
msgstr "Overrun — {budget}"

msgid "{overrun} {currency} au-delà de l'enveloppe{taux}."
msgstr "{overrun} {currency} over the envelope{taux}."

msgid "Seuil {threshold} % atteint — {budget}"
msgstr "{threshold} % threshold reached — {budget}"

msgid "{percentage} % de l'enveloppe sont engagés ou consommés."
msgstr "{percentage} % of the envelope is committed or spent."

msgid "Justificatif manquant — {number}"
msgstr "Missing supporting document — {number}"

msgid "Le dossier « {label} » est engagé sans aucune preuve."
msgstr "Dossier “{label}” is committed without any proof."

msgid "Justificatif incomplet — {number}"
msgstr "Incomplete supporting document — {number}"

msgid "{count} pièce(s) signalée(s) incomplète(s)."
msgstr "{count} document(s) flagged as incomplete."

msgid "Dépense inhabituelle — {title}"
msgstr "Unusual expense — {title}"

msgid ""
"{amount} {currency}, soit plus de {factor} fois la moyenne des autres "
"dépenses du pays."
msgstr ""
"{amount} {currency}, more than {factor} times the average of the country's "
"other expenses."

msgid "Pays : %(pays)s · Exercice : %(exercice)s · Période : %(periode)s"
msgstr "Country: %(pays)s · Fiscal year: %(exercice)s · Period: %(periode)s"

msgid "Montants exprimés dans la devise de chaque pays."
msgstr "Amounts are expressed in each country's currency."

msgid "Aucune donnée sur la période."
msgstr "No data for the period."

msgid "Rapport de contrôle budgétaire — %(periode)s"
msgstr "Budget control report — %(periode)s"

msgid "Contrôle budgétaire — %(periode)s"
msgstr "Budget control — %(periode)s"

msgid "Pays"
msgstr "Country"

msgid "Enveloppe"
msgstr "Envelope"

msgid "Budget"
msgstr "Budget"

msgid "Engagé"
msgstr "Committed"

msgid "Consommé"
msgstr "Spent"

msgid "Justifié"
msgstr "Justified"

msgid "Disponible"
msgstr "Available"

msgid "Enveloppe du pays"
msgstr "Country envelope"

msgid "Enveloppes"
msgstr "Envelopes"

msgid "Libellé"
msgstr "Label"

msgid "Date"
msgstr "Date"

msgid "Statut"
msgstr "Status"

msgid "Dépenses"
msgstr "Expenses"

msgid "Écart"
msgstr "Gap"

msgid "Dossiers de justification"
msgstr "Justification dossiers"

msgid ""
"Seuls les %(max)s dossiers les plus récents sur %(total)s figurent ici ; la "
"liste complète est dans l'export Excel des dépenses."
msgstr ""
"Only the %(max)s most recent dossiers out of %(total)s are shown here; the "
"full list is in the Excel export of expenses."

msgid "%(entete)s trop long (%(taille)s caractères, maximum %(max)s)."
msgstr "%(entete)s too long (%(taille)s characters, maximum %(max)s)."

msgid "N°ORDRE obligatoire."
msgstr "N°ORDRE is required."

msgid "%(entete)s illisible : « %(value)s »"
msgstr "%(entete)s unreadable: “%(value)s”"

msgid ""
"%(entete)s trop grand : « %(value)s » (maximum %(max)s chiffres avant la "
"virgule)."
msgstr ""
"%(entete)s too large: “%(value)s” (maximum %(max)s digits before the decimal "
"point)."

msgid "Date illisible : « %(value)s »"
msgstr "Unreadable date: “%(value)s”"

msgid "Classeur trop volumineux (maximum %(limite)s Mo)."
msgstr "Workbook too large (maximum %(limite)s MB)."

msgid "Classeur illisible : %(erreur)s"
msgstr "Unreadable workbook: %(erreur)s"

msgid "En-têtes manquants : %(colonnes)s"
msgstr "Missing headers: %(colonnes)s"

msgid ""
"Ligne d'en-tête introuvable : le classeur doit porter les colonnes "
"%(colonnes)s dans ses %(max)s premières lignes."
msgstr ""
"Header row not found: the workbook must carry the columns %(colonnes)s "
"within its first %(max)s rows."

msgid "Le classeur dépasse %(max)s lignes : scindez-le."
msgstr "The workbook exceeds %(max)s rows: split it."

msgid "Montant de dépense obligatoire."
msgstr "Expense amount is required."

msgid ""
"Indiquez à la fois la devise et le montant d'origine, ou aucun des deux."
msgstr ""
"Provide both the original currency and the original amount, or neither."

msgid "Aucun taux connu pour convertir %(devise)s en %(cible)s au %(date)s."
msgstr "No known rate to convert %(devise)s into %(cible)s on %(date)s."

msgid "Pays obligatoire : la colonne PAYS est vide."
msgstr "Country is required: the PAYS column is empty."

msgid "Pays « %(pays)s » inconnu"
msgstr "Unknown country “%(pays)s”"

msgid "Pays « %(pays)s » hors périmètre"
msgstr "Country “%(pays)s” is outside your scope"

msgid ""
"Le classeur n'a pas de colonne PAYS : indiquez le pays de l'import "
"(paramètre « country »)."
msgstr ""
"The workbook has no PAYS column: specify the import country (“country” "
"parameter)."

msgid "Le dossier « %(number)s » est déjà déclaré"
msgstr "Dossier “%(number)s” has already been declared"

msgid "Ligne identique à la ligne %(ligne)s du classeur"
msgstr "Identical to row %(ligne)s of the workbook"

msgid ""
"Ligne déjà présente dans le dossier « %(number)s » : même date, même "
"libellé, même montant"
msgstr ""
"Row already present in dossier “%(number)s”: same date, same label, same "
"amount"

msgid "hebdomadaire"
msgstr "weekly"

msgid "mensuel"
msgstr "monthly"

msgid "[Contrôle budgétaire] Rapport %(period)s — %(year)s"
msgstr "[Budget control] %(period)s report — %(year)s"

msgid ""
"- %(country)s (%(currency)s) : attribué %(allocated)s, consommé "
"%(consumed)s, justifié %(justified)s, écart %(gap)s"
msgstr ""
"- %(country)s (%(currency)s): allocated %(allocated)s, spent %(consumed)s, "
"justified %(justified)s, gap %(gap)s"

msgid "- aucune enveloppe sur le périmètre"
msgstr "- no envelope within scope"

msgid "Rapport %(period)s — exercice %(year)s"
msgstr "%(period)s report — fiscal year %(year)s"

msgid "Période couverte : depuis le %(since)s"
msgstr "Period covered: since %(since)s"

msgid "Par pays, dans la devise du pays :"
msgstr "Per country, in the country's currency:"

msgid "Consolidé en FCFA :"
msgstr "Consolidated in CFA francs:"

msgid "Enveloppes attribuées : %(amount)s"
msgstr "Allocated envelopes: %(amount)s"

msgid "Consommé : %(amount)s"
msgstr "Spent: %(amount)s"

msgid "Justifié : %(amount)s"
msgstr "Justified: %(amount)s"

msgid "Écart (dépensé sans preuve) : %(amount)s"
msgstr "Gap (spent without proof): %(amount)s"

msgid "Hors consolidation, faute de taux : %(currencies)s"
msgstr "Excluded from consolidation for lack of a rate: %(currencies)s"

msgid "Dépenses saisies sur la période : %(count)s"
msgstr "Expenses recorded over the period: %(count)s"

msgid "Dossiers sans aucun justificatif : %(count)s"
msgstr "Dossiers without any supporting document: %(count)s"

msgid "Le détail par enveloppe et par dossier figure en pièce jointe."
msgstr "The breakdown by envelope and by dossier is attached."

msgid "Le détail par enveloppe et par dossier se consulte dans l'application."
msgstr ""
"The breakdown by envelope and by dossier is available in the application."

msgid "exercice %(year)s"
msgstr "fiscal year %(year)s"

msgid "Pays introuvable."
msgstr "Country not found."

msgid "Valeur entière attendue."
msgstr "An integer value is expected."

msgid "Le mois doit être compris entre 1 et 12."
msgstr "The month must be between 1 and 12."

msgid "Le pays est obligatoire."
msgstr "The country is required."

msgid "Tous les pays du périmètre"
msgstr "All countries within scope"

msgid "Le champ file est obligatoire."
msgstr "The file field is required."

msgid "Pays inconnu."
msgstr "Unknown country."
