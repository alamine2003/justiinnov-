msgid "Le dossier est clôturé : plus aucun justificatif ne peut y être ajouté."
msgstr "The file is closed: no further supporting document can be added to it."

msgid "Ce justificatif est {status} : il ne se modifie plus. Déposez une nouvelle version s'il doit être corrigé."
msgstr "This supporting document is {status}: it can no longer be modified. Upload a new version if it needs correcting."

msgid "Ce champ est fixé au dépôt : déposez une nouvelle version plutôt que de modifier celle-ci."
msgstr "This field is fixed at upload time: upload a new version rather than modifying this one."

msgid "Pièce invalide pour ce dossier."
msgstr "Invalid document for this file."

msgid "Cette pièce a déjà été remplacée."
msgstr "This document has already been replaced."

msgid "Ce fichier est déjà rattaché à ce dossier (doublon)."
msgstr "This file is already attached to this justification file (duplicate)."

msgid "Toujours calculé : dépense − montant justifié."
msgstr "Always computed: expense − justified amount."

msgid "Cette dépense est déclarée : elle ne peut plus être modifiée. Seul un brouillon reste modifiable."
msgstr "This expense has been declared: it can no longer be modified. Only a draft remains editable."

msgid "Le dossier appartient à un autre pays."
msgstr "The file belongs to another country."

msgid "Cette entité appartient à un autre pays."
msgstr "This entity belongs to another country."

msgid "Cette dépense a été décaissée en {currency} : son montant se calcule à partir du montant décaissé. Modifiez celui-ci plutôt que la conversion."
msgstr "This expense was disbursed in {currency}: its amount is computed from the disbursed amount. Modify that rather than the conversion."

msgid "Le montant de la dépense est requis."
msgstr "The expense amount is required."

msgid "Indiquez à la fois la devise et le montant décaissés, ou aucun des deux."
msgstr "Provide both the disbursement currency and amount, or neither."

msgid "Aucun taux connu pour convertir {source} en {target} à cette date. Publiez-le dans Configuration › Taux de change."
msgstr "No known rate to convert {source} to {target} on that date. Publish it under Configuration › Exchange rates."

msgid "Ce N°ORDRE existe déjà pour ce pays."
msgstr "This order number already exists for this country."

msgid "Ce dossier est déclaré : il ne peut plus être modifié."
msgstr "This file has been declared: it can no longer be modified."

msgid "Cette équipe appartient à un autre pays."
msgstr "This team belongs to another country."

msgid "Un rejet doit être motivé."
msgstr "A rejection must state a reason."

msgid "Aucune enveloppe active pour {country} en {year}."
msgstr "No active budget envelope for {country} in {year}."

msgid "L'enveloppe imputée est inactive."
msgstr "The charged envelope is inactive."

msgid "Dépassement de {overrun} {currency} sur l'enveloppe {budget}."
msgstr "Overrun of {overrun} {currency} on envelope {budget}."

msgid "{message} Opération bloquée."
msgstr "{message} Operation blocked."

msgid "{message} La validation d'un dépassement relève de la direction (super administrateur)."
msgstr "{message} Approving an overrun is up to senior management (super administrator)."

msgid "{message} Sa validation relèvera de la direction (super administrateur)."
msgstr "{message} Its approval will be up to senior management (super administrator)."

msgid "Une réouverture doit être motivée : le pays doit savoir ce qu'on lui demande."
msgstr "A reopening must state a reason: the country must know what is being asked of it."

msgid "Aucun justificatif n'est joint : la dépense est déclarée sans preuve, elle creusera l'écart et sera signalée au siège."
msgstr "No supporting document is attached: the expense is declared without proof, it will widen the gap and be reported to headquarters."

msgid "Le dossier {number} est déjà déclaré ({status}) : il n'accepte plus de nouvelle ligne. Ouvrez un nouveau dossier pour cette dépense."
msgstr "File {number} has already been declared ({status}): it no longer accepts new lines. Open a new file for this expense."

msgid "Ce dossier contient des lignes saisies par quelqu'un d'autre ({author}) : il ne peut pas être supprimé."
msgstr "This file contains lines entered by someone else ({author}): it cannot be deleted."

msgid "Ce dossier contient une ligne déclarée : il ne peut plus être supprimé."
msgstr "This file contains a declared line: it can no longer be deleted."

msgid "Un dossier ne peut être justifié sans justificatif."
msgstr "A file cannot be justified without a supporting document."

msgid "Justifiez chaque ligne avant le dossier."
msgstr "Justify each line before the file."

msgid "Tranchez chaque ligne avant de constater la non-justification du dossier."
msgstr "Decide on each line before recording the file as unjustified."

msgid "Vous avez ouvert ce dossier : son contrôle revient à quelqu'un d'autre."
msgstr "You opened this file: its review is up to someone else."

msgid "{count} ligne(s) ne sont pas dans l'état attendu : {detail}. {instruction}"
msgstr "{count} line(s) are not in the expected state: {detail}. {instruction}"

msgid "Justifiez-les ou marquez-les non justifiées avant de clôturer."
msgstr "Justify them or mark them unjustified before closing."

msgid "{count} ligne(s) ont déjà été constatées par le siège : {detail}. Un dossier ne se rouvre pas après constat."
msgstr "{count} line(s) have already been recorded by headquarters: {detail}. A file cannot be reopened once a finding has been made."

msgid "sans équipe"
msgstr "no team"

msgid "sans manager"
msgstr "no manager"

msgid " et {count} autre(s)"
msgstr " and {count} other(s)"

msgid "{count} ligne(s) incomplète(s) : {detail}. Renseignez l'équipe et le manager de chaque ligne avant de soumettre le dossier."
msgstr "{count} incomplete line(s): {detail}. Fill in the team and manager of each line before submitting the file."

msgid "Un dossier se soumet avec ses lignes de dépenses : ajoutez-en au moins une."
msgstr "A file is submitted with its expense lines: add at least one."

msgid "Le montant justifié ne peut pas dépasser la dépense ({amount})."
msgstr "The justified amount cannot exceed the expense ({amount})."

msgid "Cette dépense n'a pas d'auteur connu : elle ne peut pas être contrôlée."
msgstr "This expense has no known author: it cannot be reviewed."

msgid "Vous avez saisi cette dépense : son contrôle revient à quelqu'un d'autre."
msgstr "You entered this expense: its review is up to someone else."

msgid "Brouillon"
msgstr "Draft"

msgid "Soumis"
msgstr "Submitted"

msgid "En contrôle"
msgstr "Under review"

msgid "Justifié"
msgstr "Justified"

msgid "Non justifié"
msgstr "Unjustified"

msgid "Clôturé"
msgstr "Closed"

msgid "aucun : la pièce est figée"
msgstr "none: the document is frozen"

msgid "Un justificatif « {current} » ne peut pas passer à « {target} » (états atteignables : {reachable})."
msgstr "A “{current}” supporting document cannot move to “{target}” (reachable states: {reachable})."

msgid "La dépense doit passer en contrôle avant d'être justifiée."
msgstr "The expense must be placed under review before being justified."

msgid "Action impossible depuis l'état « {current} » (états attendus : {expected})."
msgstr "Action not possible from state “{current}” (expected states: {expected})."
